# ==============================================================================
# SwarmTwin Environment Configuration Template
# Copy to backend/.env and populate with your cloud keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NVIDIA NIM Multimodal Vision Reasoner
# ------------------------------------------------------------------------------
# Obtain free prototype tier API key from https://build.nvidia.com
NVIDIA_API_KEY=mock-key

# Set to true for instant deterministic local reasoning without remote API latency
USE_LOCAL_REASONER=false

# Remote NVIDIA NIM request timeout in seconds before calibrated failover
NIM_TIMEOUT_SECONDS=3.0

# ------------------------------------------------------------------------------
# 2. Amazon Web Services (AWS) Cloud Persistence
# ------------------------------------------------------------------------------
# Target AWS Region
AWS_REGION=us-east-1

# S3 Bucket for high-resolution aerial disaster evidence frames
S3_BUCKET_NAME=swarmtwin-evidence-frames

# DynamoDB Table for immutable incident audit trails & agent decision logs
DYNAMO_TABLE_NAME=SwarmTwinIncidents

# IAM Credentials:
# NOTE: If running on an EC2 instance with an attached IAM Role (e.g. SwarmTwinEC2Role),
# leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY BLANK. Boto3 automatically retrieves
# temporary credentials via EC2 Instance Metadata Service (IMDSv2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
