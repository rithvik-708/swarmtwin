{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SwarmTwinS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::swarmtwin-evidence-frames",
        "arn:aws:s3:::swarmtwin-evidence-frames/*"
      ]
    },
    {
      "Sid": "SwarmTwinDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/SwarmTwinIncidents"
    }
  ]
}
