# ==============================================================================
# SwarmTwin Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (DO NOT COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
swarmtwin-ui/.env*.local
frontend/.env*.local

# ------------------------------------------------------------------------------
# Large Datasets & Archives (13 GB FloodNet ZIP & Raw Images)
# ------------------------------------------------------------------------------
FloodNet.zip
FloodNet/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Testing & Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# Local Persistence Stores & SQLite Databases
# ------------------------------------------------------------------------------
nim_cache.db
*.db
*.sqlite
*.sqlite3
data/aws_local_store/
output/

# ------------------------------------------------------------------------------
# Node.js & Frontends (swarmtwin-ui & frontend)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next/
out/

# Vite / React build output
frontend/dist/
dist/

# ------------------------------------------------------------------------------
# IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# VSCode & JetBrains
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
